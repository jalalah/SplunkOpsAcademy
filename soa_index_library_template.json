    "dataSources": {
        "ds_1OGFeZah": {
            "name": "Total Indexes",
            "options": {
                "query": "| inputlookup cnh_searchable_data\n| search default_index=N\n| stats dc(index) as \"Total Indexes\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_CyhUhOAt": {
            "name": "Indexes_ Sources_ and Sourcetypes",
            "options": {
                "query": "| inputlookup YourLookUpHere\n| search default_index=N\n| search keywords=\"*$keywords$*\"\n| search index=\"*$index$*\"\n| search description = \"*$description$*\"\n| table index sourcetype description keywords",
                "queryParameters": {
                    "earliest": "-15m",
                    "latest": "now",
                    "sampleRatio": 1
                }
            },
            "type": "ds.search"
        },
        "ds_EBijoQRF": {
            "name": "Indexes Missing Descriptions",
            "options": {
                "query": "| inputlookup cnh_searchable_data\n| search default_index=N\n| eval missing_desc=if(isnull(description) OR description=\"\",1,0)\n| stats sum(missing_desc) as \"Indexes Missing Descriptions\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_JSZEfj05": {
            "name": "Total SourceTypes",
            "options": {
                "query": "| inputlookup cnh_searchable_data\n| search default_index=N\n| stats dc(sourcetype) as \"Total Sourcetypes\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        }
    },
