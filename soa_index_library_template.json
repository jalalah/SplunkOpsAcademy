        "viz_yQzInNxD": {
            "dataSources": {
                "primary": "ds_1OGFeZah"
            },
            "eventHandlers": [
                {
                    "options": {
                        "earliest": "auto",
                        "latest": "auto",
                        "newTab": false,
                        "query": "| inputlookup cnh_searchable_data\n| search default_index=N\n| stats count by index\n| sort index",
