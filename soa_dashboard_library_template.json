    "dataSources": {
        "ds_dashboard_library": {
            "name": "Dashboard Library",
            "options": {
                "query": "| rest /servicesNS/-/-/data/ui/views count=0\n| rename eai:acl.app AS app\n| where app=\"search\" ``` change if you want to pull from more apps ```\n| search description=\"*$description$*\"\n| search label=\"*$label$*\"\n| search author=\"*$author$*\"\n| eval description=if(isnull(description) OR trim(description)=\"\", \"No description provided. Please review the app or contact the owner to add a description.\", description)\n| table label description author\n| rename label AS \"Dashboard Name\" description AS \"Description\" author AS \"Owner\"\n| sort App \"Dashboard Name\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_missing_descriptions": {
            "name": "Missing Descriptions",
            "options": {
                "query": "| rest /servicesNS/-/-/data/ui/views count=0\n| rename eai:acl.app AS app\n| where app=\"search\"\n| eval missing_description=if(isnull(description) OR trim(description)=\"\", 1, 0)\n| stats sum(missing_description) AS \"Missing Descriptions\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_total_dashboards": {
            "name": "Total Dashboards",
            "options": {
                "query": "| rest /servicesNS/-/-/data/ui/views count=0\n| rename eai:acl.app AS app\n| where app=\"search\"\n| stats count AS \"Total Dashboards\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_total_owners": {
            "name": "Dashboard Owners",
            "options": {
                "query": "| rest /servicesNS/-/-/data/ui/views count=0\n| rename eai:acl.app AS app\n| where app=\"search\"\n| stats dc(author) AS \"Dashboard Owners\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        }
    },
