        "viz_owner_text": {
            "options": {
                "customFontSize": 16,
                "fontColor": "#FFFFFF",
                "fontSize": "custom",
                "markdown": "[ENTER YOUR ORGANIZATION'S OWNERSHIP AND MAINTENANCE EXPECTATIONS]\n\nSuggested topics:\n- Dashboard owner or team contact\n- Review and validation frequency\n- Access and permission requests\n- Change management\n- Archival expectations\n- Supporting documentation"
            },
            "type": "splunk.markdown"
        },
        "viz_owner_title": {
            "options": {
                "customFontSize": 24,
                "fontColor": "#FFFFFF",
                "fontSize": "custom",
                "markdown": "👥 Ownership & Maintenance"
            },
            "type": "splunk.markdown"
        },
        "viz_required_bg": {
            "options": {
                "fillColor": "#163A2E",
                "strokeColor": "#38C172"
            },
            "type": "splunk.rectangle"
        },
        "viz_required_text": {
            "options": {
                "customFontSize": 16,
                "fontColor": "#FFFFFF",
                "fontSize": "custom",
                "markdown": "[ENTER YOUR ORGANIZATION'S REQUIRED DASHBOARD METADATA]\n\nSuggested fields:\n- Dashboard name\n- Description\n- Created by\n- Maintained by\n- Last updated date\n- Data sources\n- Purpose statement"
