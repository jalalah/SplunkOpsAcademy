        "viz_header_title": {
            "options": {
                "customFontSize": 36,
                "fontColor": "#FFFFFF",
                "fontSize": "custom",
                "markdown": "## Dashboard Documentation & Best Practices"
            },
            "type": "splunk.markdown"
        },
        "viz_intro_bg": {
            "options": {
                "fillColor": "#102D4F",
                "strokeColor": "#3E8BFF"
            },
            "type": "splunk.rectangle"
        },
        "viz_intro_text": {
            "options": {
                "customFontSize": 18,
                "fontColor": "#FFFFFF",
                "fontSize": "custom",
                "markdown": "[ENTER AN INTRODUCTION EXPLAINING WHY DASHBOARD DOCUMENTATION, OWNERSHIP, DESIGN, AND MAINTENANCE STANDARDS ARE IMPORTANT TO YOUR ORGANIZATION]"
            },
            "type": "splunk.markdown"
        },
        "viz_note_bg": {
            "options": {
                "fillColor": "#3B2C14",
                "strokeColor": "#F5B942"
            },
            "type": "splunk.rectangle"
        },
        "viz_note_icon": {
            "options": {
                "customFontSize": 32,
                "fontColor": "#F5B942",
