        "viz_note_text": {
            "options": {
                "customFontSize": 18,
                "fontColor": "#FFFFFF",
                "fontSize": "custom",
                "markdown": "**Important:** [ENTER AN IMPORTANT REQUIREMENT OR NOTE ABOUT DASHBOARD DOCUMENTATION, SECURITY, ACCESS, OR MAINTENANCE]"
            },
            "type": "splunk.markdown"
        },
        "viz_owner_bg": {
            "options": {
                "fillColor": "#312455",
                "strokeColor": "#9A6DFF"
